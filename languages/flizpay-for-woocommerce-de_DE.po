msgid "FLIZpay could not be reached."
msgstr "FLIZpay konnte nicht erreicht werden."

#: admin/class-flizpay-connect.php:124
msgid "FLIZpay rejected the connection."
msgstr "FLIZpay hat die Verbindung abgelehnt."

#: admin/class-flizpay-connect.php:141
msgid "FLIZpay could not configure the webhook."
msgstr "FLIZpay konnte den Webhook nicht einrichten."

#: admin/class-flizpay-auto-update.php:22
msgid "Automatic updates for FLIZpay are enabled."
msgstr "Automatische Updates für FLIZpay sind aktiviert."

#: admin/class-flizpay-auto-update.php:32
msgid "Enable automatic updates so FLIZpay always runs the latest fixes and improvements."
msgstr "Aktiviere automatische Updates, damit FLIZpay immer die neuesten Fehlerbehebungen und Verbesserungen erhält."

#: admin/class-flizpay-auto-update.php:32
msgid "Enable automatic updates"
msgstr "Automatische Updates aktivieren"

#: admin/class-flizpay-auto-update.php:41
msgid "Don't ask again"
msgstr "Nicht mehr fragen"

#: admin/class-flizpay-auto-update.php:52
msgid "You are not allowed to manage plugin updates."
msgstr "Du darfst Plugin-Updates nicht verwalten."

#: admin/class-flizpay-connect.php
msgid "Connect this shop to your FLIZpay account:"
msgstr "Verbinde diesen Shop mit deinem FLIZpay-Konto:"

#: admin/class-flizpay-connect.php
msgid "You will confirm in your FLIZpay dashboard which account this shop belongs to."
msgstr "In deinem FLIZpay-Dashboard bestätigst du, zu welchem Konto dieser Shop gehört."

#: admin/class-flizpay-connect.php
msgid "Connect with FLIZpay"
msgstr "Mit FLIZpay verbinden"

#: admin/class-flizpay-connect.php
msgid "This connection attempt expired. Start it again."
msgstr "Dieser Verbindungsversuch ist abgelaufen. Starte ihn erneut."

#: admin/class-flizpay-connect.php
msgid "Copy code"
msgstr "Code kopieren"

#: includes/class-flizpay-api-service.php
msgid "This shop is not confirmed in your FLIZpay dashboard yet."
msgstr "Dieser Shop ist in deinem FLIZpay-Dashboard noch nicht bestätigt."

#: admin/class-flizpay-connect.php
msgid "Confirm your shop’s connection in your FLIZpay account."
msgstr "Bestätige die Verbindung Deines Shops in Deinem FLIZpay-Konto."

#: admin/class-flizpay-connect.php
msgid "If you’re not redirected automatically, open the FLIZpay setup and paste the connection code below."
msgstr "Falls Du nicht automatisch weitergeleitet wirst, öffne FLIZ einrichten und füge dort den Verbindungscode ein."

#: admin/class-flizpay-connect.php
msgid "Open FLIZpay setup"
msgstr "FLIZ einrichten öffnen"

#: admin/class-flizpay-connect.php
msgid "Once you’ve entered the code and confirmed the connection in your FLIZ account, return here and click “Complete connection”."
msgstr "Sobald du den Code in deinem FLIZ-Konto eingegeben und die Verbindung bestätigt hast, kehre hierher zurück und klicke auf „Verbindung abschließen“."

#: admin/class-flizpay-connect.php
msgid "Complete connection"
msgstr "Verbindung abschließen"
